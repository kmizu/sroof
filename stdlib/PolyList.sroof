// stdlib v2: PolyList (polymorphic, element type A: Type)
//
// Structural induction over polymorphic inductives is supported as of v0.7.
// The type parameter is declared *first* in every signature so that a
// constructor field's type and a definition's parameter type agree: both are the
// applied `PolyList(A)` rather than a bare `PolyList`.

inductive Nat {
  case zero: Nat
  case succ(n: Nat): Nat
}

inductive Bool {
  case true: Bool
  case false: Bool
}

def plus(n: Nat, m: Nat): Nat {
  match n {
    case Nat.zero    => m
    case Nat.succ(k) => Nat.succ(plus(k, m))
  }
}

// Polymorphic list.  The type parameter comes first and every occurrence of the
// type is the applied `PolyList(A)`, so a constructor field's type and a
// definition's parameter type agree.  Recursion is on `xs`; it does not have to
// be the first parameter for the termination checker.
inductive PolyList(A: Type) {
  case nil: PolyList
  case cons(head: A, tail: PolyList(A)): PolyList
}

def poly_length(A: Type, xs: PolyList(A)): Nat {
  match xs {
    case PolyList.nil        => Nat.zero
    case PolyList.cons(h, t) => Nat.succ(poly_length(A, t))
  }
}

def poly_append(A: Type, xs: PolyList(A), ys: PolyList(A)): PolyList(A) {
  match xs {
    case PolyList.nil        => ys
    case PolyList.cons(h, t) => PolyList.cons(h, poly_append(A, t, ys))
  }
}

def poly_reverse(A: Type, xs: PolyList(A)): PolyList(A) {
  match xs {
    case PolyList.nil        => PolyList.nil
    case PolyList.cons(h, t) =>
      poly_append(A, poly_reverse(A, t), PolyList.cons(h, PolyList.nil))
  }
}

// ---- Base-case defspecs (trivial) ----

defspec poly_length_nil(A: Type): poly_length(A, PolyList.nil) = Nat.zero {
  by trivial
}

defspec poly_append_nil_left(A: Type, ys: PolyList(A)): poly_append(A, PolyList.nil, ys) = ys {
  by trivial
}

defspec poly_reverse_nil(A: Type): poly_reverse(A, PolyList.nil) = PolyList.nil {
  by trivial
}

// ---- Inductive defspecs over the polymorphic list ----
//
// These are the proofs the header used to say were impossible.  They need the
// induction hypothesis under a constructor, which is exactly what parameterised
// induction unlocked: the branch context now instantiates a constructor field's
// type against the scrutinee's type argument instead of leaving the type
// parameter dangling.

inductive PList(A: Type) {
  case pnil: PList(A)
  case pcons(head: A, tail: PList(A)): PList(A)
}

def plist_append(A: Type, xs: PList(A), ys: PList(A)): PList(A) {
  match xs {
    case PList.pnil        => ys
    case PList.pcons(h, t) => PList.pcons(h, plist_append(A, t, ys))
  }
}

def plist_copy(A: Type, xs: PList(A)): PList(A) {
  match xs {
    case PList.pnil        => PList.pnil
    case PList.pcons(h, t) => PList.pcons(h, plist_copy(A, t))
  }
}

defspec plist_append_nil_right(A: Type, xs: PList(A)):
    plist_append(A, xs, PList.pnil) = xs {
  by induction xs {
    case pnil         => trivial
    case pcons h t ih => simplify [ih]
  }
}

defspec plist_copy_id(A: Type, xs: PList(A)): plist_copy(A, xs) = xs {
  by induction xs {
    case pnil         => trivial
    case pcons h t ih => simplify [ih]
  }
}
