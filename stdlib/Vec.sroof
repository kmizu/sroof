// stdlib v1: Vec
//
// NOTE: the `n: Nat` below is a **phantom** index.  A constructor's declared
// return type is parsed and discarded, and `CtorDef.retIndices` is never
// populated, so `Vec.nil` and `Vec.cons(...)` have the same type as far as the
// checker is concerned — nothing about lengths can be stated or proved yet.
// The bare `Vec` in the signatures below is not a style choice: the parser
// cannot express `Vec(A)(Nat.zero)` in a constructor's return type.
// See docs/indexed-families.md for what real index support would require.

inductive Nat {
  case zero: Nat
  case succ(n: Nat): Nat
}

def plus(n: Nat, m: Nat): Nat {
  match n {
    case Nat.zero    => m
    case Nat.succ(k) => Nat.succ(plus(k, m))
  }
}

inductive Vec(A: Type)(n: Nat) {
  case nil: Vec
  case cons(m: Nat, head: A, tail: Vec(A)): Vec
}

def concat(xs: Vec, ys: Vec, A: Type, n: Nat, m: Nat): Vec {
  match xs {
    case Vec.nil           => ys
    case Vec.cons(k, h, t) => Vec.cons(plus(k, m), h, concat(t, ys, A, k, m))
  }
}

// length consistency baseline lemma for nil branch

defspec concat_nil(A: Type, ys: Vec): concat(Vec.nil, ys, A, Nat.zero, Nat.zero) = ys {
  by trivial
}
