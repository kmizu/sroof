// stdlib v2: Vec — a list whose length is in its type.
//
// The `n: Nat` is a real index, not a phantom one: each constructor declares
// the length of the value it builds, and the checker derives that length rather
// than taking a caller's word for it.  `Vec.nil` is a `Vec(A)(Nat.zero)` and
// nothing else.
//
// `concat`'s return type is therefore the length theorem, and there is no
// separate lemma to prove: appending an n-vector to an m-vector yields a
// `plus(n, m)`-vector, and since v0.14 a `def` body is kernel-checked, so that
// claim is verified.  Change it and this file stops checking.
//
// Converted from the phantom form in v0.15; see docs/indexed-families.md.

inductive Nat {
  case zero: Nat
  case succ(n: Nat): Nat
}

def plus(n: Nat, m: Nat): Nat {
  match n {
    case Nat.zero    => m
    case Nat.succ(k) => Nat.succ(plus(k, m))
  }
}

inductive Vec(A: Type)(n: Nat) {
  case nil: Vec(A)(Nat.zero)
  case cons(m: Nat, head: A, tail: Vec(A)(m)): Vec(A)(Nat.succ(m))
}

// The length theorem, carried by the type.  The type parameter comes first so a
// constructor field's type and a definition's parameter type are both the
// applied form.
def concat(A: Type, n: Nat, m: Nat, xs: Vec(A)(n), ys: Vec(A)(m)): Vec(A)(plus(n, m)) {
  match xs {
    case Vec.nil           => ys
    case Vec.cons(k, h, t) => Vec.cons(plus(k, m), h, concat(A, k, m, t, ys))
  }
}

// Appending onto the empty vector is the identity — by reduction, once the
// index bookkeeping above is accepted.
defspec concat_nil(A: Type, m: Nat, ys: Vec(A)(m)): concat(A, Nat.zero, m, Vec.nil, ys) = ys {
  by trivial
}

// `vlen` reads the length back out, and it agrees with the index for every
// vector — proved by induction, which needs the hypothesis at the tail's index.
def vlen(A: Type, n: Nat, v: Vec(A)(n)): Nat {
  match v {
    case Vec.nil           => Nat.zero
    case Vec.cons(m, h, t) => Nat.succ(vlen(A, m, t))
  }
}

defspec vlen_is_index(A: Type, n: Nat, v: Vec(A)(n)): vlen(A, n, v) = n {
  by induction v {
    case nil            => trivial
    case cons m h t ih  => simplify [ih]
  }
}
