// Indexed families: a length that the type checker enforces.
//
// `Vec(A)(n)` is a list of `A` whose length is `n`.  The `n` is not a comment
// and not a phantom: each constructor *declares* the index of the value it
// builds, and the checker derives that index rather than taking the caller's
// word for it.
//
// Compare `stdlib/Vec.sroof`, whose constructors return a bare `Vec`.  That is
// the older form, still supported, in which the index carries no information —
// see docs/indexed-families.md for why both exist.

inductive Nat {
  case zero: Nat
  case succ(n: Nat): Nat
}

// The two return types are the whole point:
//   vnil  builds a vector of length zero
//   vcons builds one of length succ(m) out of a tail of length m
inductive Vec(A: Type)(n: Nat) {
  case vnil: Vec(A)(Nat.zero)
  case vcons(m: Nat, head: A, tail: Vec(A)(m)): Vec(A)(Nat.succ(m))
}

// The empty vector has length zero, and nothing else.
defspec vnil_has_length_zero: Vec(Nat)(Nat.zero) {
  Vec.vnil
}

// Consing onto the empty vector gives length one.
defspec vcons_has_length_one: Vec(Nat)(Nat.succ(Nat.zero)) {
  Vec.vcons(Nat.zero, Nat.zero, Vec.vnil)
}

// Lengths compose: the tail's index has to line up with the `m` given to
// `vcons`, so a nested vector is checked all the way down.
defspec two_elements_have_length_two: Vec(Nat)(Nat.succ(Nat.succ(Nat.zero))) {
  Vec.vcons(Nat.succ(Nat.zero), Nat.zero,
    Vec.vcons(Nat.zero, Nat.zero, Vec.vnil))
}

// ---- Reasoning about an arbitrary vector ----
//
// `vlen` reads the length back off the constructor.  Since v0.12 an indexed
// family may appear as a parameter type, so `v: Vec(A)(n)` is legal here.
def vlen(A: Type, n: Nat, v: Vec(A)(n)): Nat {
  match v {
    case Vec.vnil           => Nat.zero
    case Vec.vcons(m, h, t) => Nat.succ(m)
  }
}

// The first theorem in this file about *every* vector rather than a particular
// one — and the first that needs the index to mean something.
//
// It works because each branch learns its index: matching `vnil` out of a
// `Vec(A)(n)` tells you `n` is `Nat.zero` there, so the goal becomes
// `vlen(A, zero, vnil) = zero` rather than the unprovable `... = n`.
// Likewise the `vcons` branch is asked for `succ(m) = succ(m)`.
defspec vlen_matches_index(A: Type, n: Nat, v: Vec(A)(n)): vlen(A, n, v) = n {
  by cases v {
    case vnil        => trivial
    case vcons m h t => trivial
  }
}

// Each of the following is a type error.  They are kept here as comments
// because an example file has to keep checking; `cli/.../IndexedFamilySuite.scala`
// asserts that every one of them is rejected.
//
//   defspec wrong: Vec(Nat)(Nat.succ(Nat.zero)) { Vec.vnil }
//     expected: ((Vec Nat) (succ zero))
//     actual:   ((Vec Nat) zero)
//
//   defspec wrong_tail: Vec(Nat)(Nat.succ(Nat.succ(Nat.zero))) {
//     Vec.vcons(Nat.succ(Nat.zero), Nat.zero, Vec.vnil)
//   }
//     the tail is length zero where length one was required
//
// Before v0.10.0 both of them checked successfully.

// ---- Induction, with a working induction hypothesis ----
//
// `vlenr` is the same length function written by recursion on the tail, which is
// what makes a proof about it need an induction hypothesis.
def vlenr(A: Type, n: Nat, v: Vec(A)(n)): Nat {
  match v {
    case Vec.vnil           => Nat.zero
    case Vec.vcons(m, h, t) => Nat.succ(vlenr(A, m, t))
  }
}

// Since v0.13, `induction` over an indexed family binds the index before the
// vector, so the hypothesis can be stated at the *tail's* index:
//
//   Fix(_rec, Pi(_i, Nat, Pi(_n, Vec A _i, P(_i)(_n))), ...)
//
// In the `vcons` branch `ih` is therefore `vlenr(A, m, t) = m` — about the tail,
// not about the whole vector — which is exactly what `simplify` needs.
defspec vlenr_correct(A: Type, n: Nat, v: Vec(A)(n)): vlenr(A, n, v) = n {
  by induction v {
    case vnil           => trivial
    case vcons m h t ih => simplify [ih]
  }
}

// What is still missing, and it is no longer the tactic engine: a `def` body is
// not type-checked at all, so a dependently-typed definition's return index is
// never verified.  `def vapp(...): Vec(A)(plus(n, m))` would be accepted whatever
// it returned.  That is why `stdlib/Vec.sroof` has not been rewritten with real
// indices — the declaration would promise a length nothing checks.
// See step 5 in docs/indexed-families.md.
